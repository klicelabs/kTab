{
	"name": "ktab",
	"version": "1.3.5",
	"private": true,
	"description": "A minimal, high-performance new tab extension & speed dial.",
	"type": "module",
	"scripts": {
		"dev": "wxt --port 5555",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"compile": "tsc --noEmit",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@ktab/ui": "workspace:*",
		"@tanstack/react-virtual": "^3.14.26",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "catalog:",
		"motion": "^13.2.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"recharts": "^3.8.0",
		"sonner": "catalog:",
		"tailwind-merge": "^3.6.0",
		"zustand": "^5.0.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@wxt-dev/module-react": "^1.1.5",
		"fake-indexeddb": "6.2.8",
		"linkedom": "^0.18.13",
		"postcss": "^8.5.19",
		"tailwindcss": "^4.3.2",
		"typescript": "^5.9.3",
		"wxt": "^0.20.27"
	}
}
